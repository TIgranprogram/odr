# Пример переменных окружения. Скопируйте в .env и заполните реальными значениями.
# .env в .gitignore — секреты не попадут в репозиторий.

# Backend
PORT=3000
MONGO_URI=mongodb://localhost:27017/kppdf
JWT_SECRET=change_me_to_a_long_random_string
NODE_ENV=development

# Seed-скрипт: путь к папке с CSV-выгрузками
SEED_DATA_DIR=D:/ОДР/данные для заполнения на сайте
