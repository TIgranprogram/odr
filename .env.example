# Пример переменных окружения. Скопируйте в .env и заполните реальными значениями.
# .env в .gitignore — секреты не попадут в репозиторий.

# Backend
PORT=3000
MONGO_URI=mongodb://localhost:27017/kppdf
NODE_ENV=development

# Секреты JWT: access и refresh должны быть РАЗНЫМИ в production.
JWT_SECRET=change_me_to_a_long_random_string
REFRESH_SECRET=change_me_to_another_long_random_string

# CORS: белый список origin через запятую
CORS_ORIGINS=http://localhost:4200,http://localhost:3000

# Seed-скрипт: путь к папке с CSV-выгрузками (по умолчанию — «данные для заполнения на сайте/data»)
SEED_DATA_DIR=./данные для заполнения на сайте/data
